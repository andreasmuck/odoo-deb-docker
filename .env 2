# Docker Compose project name.
# Use a different value for each isolated Odoo environment.
COMPOSE_PROJECT_NAME=odoo19e

# Filename of the Odoo Enterprise .deb placed in ./deb/
ODOO_DEB=odoo_19.0+e.20260906_all.deb

# Used only as the local Docker image tag.
ODOO_VERSION=19-20260906

# Host-side port. Odoo still listens on 8069 inside the container.
ODOO_PORT=8079
